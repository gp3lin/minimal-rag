# Ollama — sadece LLM için (embedding artık Ray Serve'de)
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:4b

# Embedding Servisi (Ray Serve — all-MiniLM-L6-v2, 384-dim)
# Docker içinden: EMBED_SERVICE_URL=http://embedding-service:8001
# Lokalde:        EMBED_SERVICE_URL=http://localhost:8001
EMBED_SERVICE_URL=http://embedding-service:8001

# Qdrant — Docker Compose network'ü içinde container adı ile erişim
# Lokalde (Docker dışında) çalışırken QDRANT_HOST=localhost yap
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=math_papers
VECTOR_SIZE=384

# Chunking parametreleri
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# PostgreSQL — sohbet geçmişi
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis — semantic cache
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=86400

# Neo4j — knowledge graph (Proje 4)
# Docker içinden: NEO4J_URI=bolt://neo4j:7687
# Lokalde: NEO4J_URI=bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragpassword
GRAPH_TOP_K=5
